{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "dev-only-key-please-change-in-production-0123456789",
    "Issuer": "objectDetection",
    "Audience": "objectDetectionClient",
    "ExpireMinutes": 120
  },
  "Monitoring": {
    "HeartbeatTimeoutSeconds": 60,
    "HeartbeatIntervalSeconds": 15,
    "DetectionRetentionDays": 30,
    "ViolationRetentionDays": 180,
    "StatsBackfillDays": 31
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=ObjectDetectionDb;Trusted_Connection=True;TrustServerCertificate=True;"
  }

}
